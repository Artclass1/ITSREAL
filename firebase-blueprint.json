{
  "entities": {
    "Property": {
      "title": "Property",
      "description": "A property listing.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "listingType": { "type": "string", "enum": ["buy", "sell"] },
        "propertyType": { "type": "string", "enum": ["apartment", "house", "land", "commercial"] },
        "location": { "type": "string" },
        "imageUrl": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "timestamp" },
        "ownerId": { "type": "string" }
      },
      "required": ["title", "description", "price", "listingType", "location", "createdAt", "ownerId"]
    }
  },
  "firestore": {
    "properties/{propertyId}": {
      "schema": { "$ref": "#/entities/Property" },
      "description": "Stores all property listings."
    }
  }
}
