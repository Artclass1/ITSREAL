rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidProperty(data) {
      return data.keys().hasAll(['title', 'description', 'price', 'listingType', 'location', 'createdAt', 'ownerId']) &&
             data.keys().size() >= 7 && data.keys().size() <= 10 &&
             data.title is string && data.title.size() <= 150 &&
             data.description is string && data.description.size() <= 5000 &&
             data.price is number && data.price >= 0 &&
             data.listingType in ['buy', 'sell'] &&
             data.location is string && data.location.size() <= 200 &&
             data.ownerId == request.auth.uid &&
             data.createdAt == request.time &&
             data.get('propertyType', 'default') is string && data.get('propertyType', '').size() <= 50 &&
             data.get('imageUrl', 'default') is string && data.get('imageUrl', '').size() <= 1000 &&
             data.get('features', []) is list && data.get('features', []).size() <= 20;
    }

    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(propertyId) && isValidProperty(incoming());
      
      allow update: if isSignedIn() && isValidId(propertyId) && existing().ownerId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'price', 'listingType', 'location', 'propertyType', 'imageUrl', 'features', 'updatedAt']) &&
        incoming().title is string && incoming().title.size() <= 150 &&
        incoming().description is string && incoming().description.size() <= 5000 &&
        incoming().price is number && incoming().price >= 0 &&
        incoming().listingType in ['buy', 'sell'] &&
        incoming().location is string && incoming().location.size() <= 200 &&
        incoming().get('propertyType', 'default') is string && incoming().get('propertyType', '').size() <= 50 &&
        incoming().get('imageUrl', 'default') is string && incoming().get('imageUrl', '').size() <= 1000 &&
        incoming().get('features', []) is list && incoming().get('features', []).size() <= 20 &&
        incoming().updatedAt == request.time && 
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt;

      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
